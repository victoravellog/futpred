<%= render layout: "shared/auth_layout", locals: { title: t("auth.login"), subtitle: capture { %>
  <%= t("auth.no_account") %>
  <%= link_to t("auth.register"), new_registration_path, class: "font-medium text-indigo-300 hover:text-indigo-200" %>
<% } } do %>
  <%= form_with url: session_path, class: "space-y-4" do |f| %>
    <div>
      <%= f.label :email_address, t("auth.email"), class: "auth-label" %>
      <%= f.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
          value: params[:email_address], placeholder: "tu@email.com", class: "auth-input" %>
    </div>

    <div>
      <%= f.label :password, t("auth.password"), class: "auth-label" %>
      <%= f.password_field :password, required: true, autocomplete: "current-password",
          maxlength: 72, placeholder: "********", class: "auth-input" %>
    </div>

    <div class="flex justify-end">
      <%= link_to t("auth.forgot_password"), new_password_path, class: "text-sm text-white/70 hover:text-white" %>
    </div>

    <%= f.submit t("auth.login_button"), class: "btn-primary btn-lg w-full shadow-lg" %>
  <% end %>
<% end %>
