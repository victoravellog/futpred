<div class="min-h-screen flex flex-col items-center justify-center bg-gray-50">
  <%= image_tag "futpred-logo.svg", alt: t("app_name"), class: "h-128" %>

  <div class="max-w-md w-full space-y-8 p-8 bg-white rounded-lg shadow">
    <div class="text-center">
      <h2 class="text-3xl font-bold text-gray-900"><%= t("auth.login") %></h2>
      <p class="mt-2 text-center text-sm text-gray-600">
        <%= t("auth.no_account") %>
        <%= link_to t("auth.register"), new_registration_path, class: "font-medium text-indigo-600 hover:text-indigo-500" %>
      </p>
    </div>

    <% if flash[:alert] %>
      <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <% if flash[:notice] %>
      <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded">
        <%= flash[:notice] %>
      </div>
    <% end %>

    <%= form_with url: session_path, class: "mt-8 space-y-6" do |f| %>
      <div class="space-y-4">
        <div>
          <%= f.label :email_address, t("auth.email"), class: "block text-sm font-medium text-gray-700" %>
          <%= f.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address],
              class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>

        <div>
          <%= f.label :password, t("auth.password"), class: "block text-sm font-medium text-gray-700" %>
          <%= f.password_field :password, required: true, autocomplete: "current-password", maxlength: 72,
              class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>
      </div>

      <div class="flex items-center justify-between">
        <%= link_to t("auth.forgot_password"), new_password_path, class: "text-sm text-indigo-600 hover:text-indigo-500" %>
      </div>

      <%= f.submit t("auth.login_button"), class: "w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 cursor-pointer" %>
    <% end %>
  </div>
</div>
