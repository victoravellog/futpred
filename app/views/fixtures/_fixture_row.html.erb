<%= turbo_frame_tag dom_id(fixture) do %>
  <div class="px-4 py-2.5 hover:bg-white/5 transition-colors" id="<%= dom_id(fixture, :container) %>">
    <div class="flex items-center justify-center gap-2 sm:gap-4 max-w-2xl mx-auto">
      <%# Equipo local %>
      <div class="flex items-center justify-end gap-1.5 sm:gap-2 flex-1 min-w-0">
        <span class="font-medium text-white text-sm truncate"><%= fixture.home_team.display_name %></span>
        <%= render "teams/logo", team: fixture.home_team %>
      </div>

      <%# Marcador / Hora / Predicción - todo junto %>
      <div class="flex items-center gap-2 shrink-0">
        <% if fixture.finished? %>
          <div class="flex flex-col items-center w-14">
            <span class="text-base font-bold text-white"><%= fixture.home_score %> - <%= fixture.away_score %></span>
            <% if fixture.decided_by_penalties? %>
              <span class="text-[9px] text-white/50 leading-none">(<%= fixture.home_penalty_score %>-<%= fixture.away_penalty_score %> pen)</span>
            <% end %>
          </div>
        <% elsif fixture.live? %>
          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-red-500/20 text-red-400 w-14 justify-center animate-pulse">
            <%= t("fixtures.live") %>
          </span>
        <% else %>
          <span class="text-xs text-white/40 w-14 text-center"
                data-controller="local-time"
                data-local-time-datetime-value="<%= fixture.kickoff_at.iso8601 %>"
                data-local-time-format-value="time">
            <%= fixture.kickoff_at.strftime("%H:%M") %>
          </span>
        <% end %>

        <%# Predicción inline %>
        <%= render "predictions/form", fixture: fixture, prediction: fixture.predictions.find_by(user: Current.user) || fixture.predictions.build %>
      </div>

      <%# Equipo visitante %>
      <div class="flex items-center gap-1.5 sm:gap-2 flex-1 min-w-0">
        <%= render "teams/logo", team: fixture.away_team %>
        <span class="font-medium text-white text-sm truncate"><%= fixture.away_team.display_name %></span>
      </div>
    </div>
  </div>
<% end %>
