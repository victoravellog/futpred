<%= turbo_frame_tag dom_id(fixture) do %>
  <div class="fixture-card <%= 'fixture-card-live' if fixture.live? %> cursor-pointer"
       id="<%= dom_id(fixture, :container) %>"
       data-controller="fixture-modal"
       data-action="click->fixture-modal#open">
    <% if fixture.live? %>
      <div class="absolute top-0 left-0 right-0 h-1 bg-red-500 rounded-t-lg"></div>
      <div class="flex items-center justify-center gap-1 mb-1">
        <span class="w-2 h-2 bg-red-500 rounded-full animate-pulse"></span>
        <span class="text-[10px] font-bold text-red-400 uppercase tracking-wide">Live</span>
      </div>
    <% end %>

    <%# Fecha y hora %>
    <div class="text-[10px] text-white/50 mb-1.5 text-center">
      <span data-controller="local-time"
            data-local-time-datetime-value="<%= fixture.kickoff_at.iso8601 %>"
            data-local-time-format-value="time"
            data-local-time-accordion-date-value="<%= local_assigns[:accordion_date] %>">
        <%= fixture.kickoff_at.strftime("%H:%M") %>
      </span>
    </div>

    <%# Equipos y marcador %>
    <div class="flex flex-col items-center gap-1.5">
      <%# Local %>
      <div class="flex items-center gap-1.5 w-full justify-center">
        <%= render "teams/logo", team: fixture.home_team, size: :small %>
        <span class="team-name-truncate"><%= fixture.home_team.display_name %></span>
      </div>

      <%# Marcador o VS %>
      <% if fixture.finished? %>
        <span class="text-sm font-bold text-white"><%= fixture.home_score %> - <%= fixture.away_score %></span>
      <% elsif fixture.live? %>
        <span class="text-sm font-bold text-red-400"><%= fixture.home_score || 0 %> - <%= fixture.away_score || 0 %></span>
      <% else %>
        <span class="text-[10px] text-white/30">vs</span>
      <% end %>

      <%# Visitante %>
      <div class="flex items-center gap-1.5 w-full justify-center">
        <%= render "teams/logo", team: fixture.away_team, size: :small %>
        <span class="team-name-truncate"><%= fixture.away_team.display_name %></span>
      </div>
    </div>

    <%# Predicción compacta %>
    <div class="mt-2 pt-2 border-t border-white/10">
      <div class="flex justify-center">
        <% prediction = @user_predictions&.dig(fixture.id) || fixture.predictions.build %>
        <%= render "predictions/form", fixture: fixture, prediction: prediction, organization_tournament: @organization_tournament, user_in_multiple_groups: @user_in_multiple_groups %>
      </div>
    </div>

    <%# Modal %>
    <%= render "fixtures/fixture_modal", fixture: fixture %>
  </div>
<% end %>
