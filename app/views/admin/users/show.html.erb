<div>
  <%= render "admin/shared/navbar" %>

  <main class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
    <div class="px-4 sm:px-0">
      <%= link_to t("admin.back"), admin_users_path, class: "text-sm text-indigo-400 hover:text-indigo-300 mb-4 inline-block" %>

      <h1 class="text-2xl font-bold text-white mb-2"><%= @user.display_name %></h1>
      <p class="text-white/60 mb-6"><%= @user.email_address %></p>

      <div class="grid gap-4 md:grid-cols-3 mb-8">
        <div class="card p-6">
          <p class="text-sm text-white/60"><%= t("admin.users.organizations") %></p>
          <p class="text-3xl font-bold text-white"><%= @organizations.count %></p>
        </div>
        <div class="card p-6">
          <p class="text-sm text-white/60"><%= t("admin.users.predictions") %></p>
          <p class="text-3xl font-bold text-white"><%= @user.predictions.count %></p>
        </div>
        <div class="card p-6">
          <p class="text-sm text-white/60"><%= t("admin.users.joined") %></p>
          <p class="text-xl font-bold text-white"><%= l(@user.created_at, format: :short) %></p>
        </div>
      </div>

      <div class="card p-6">
        <h2 class="text-lg font-medium text-white mb-4"><%= t("admin.users.organizations_list") %></h2>
        <div class="space-y-3">
          <% @organizations.each do |org| %>
            <%= link_to admin_organization_path(org), class: "block p-3 rounded-lg bg-white/5 hover:bg-white/10 transition" do %>
              <p class="font-medium text-white"><%= org.name %></p>
            <% end %>
          <% end %>
          <% if @organizations.empty? %>
            <p class="text-white/50"><%= t("admin.users.no_organizations") %></p>
          <% end %>
        </div>
      </div>
    </div>
  </main>
</div>
