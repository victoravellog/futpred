<div>
  <%= render "admin/shared/navbar" %>

  <main class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
    <div class="px-4 sm:px-0">
      <h1 class="text-2xl font-bold text-white mb-6"><%= t("admin.organizations.title") %></h1>

      <div class="card overflow-hidden">
        <table class="min-w-full divide-y divide-white/10">
          <thead class="bg-white/5">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-white/60 uppercase tracking-wider">
                <%= t("admin.organizations.name") %>
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-white/60 uppercase tracking-wider">
                <%= t("admin.organizations.members") %>
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-white/60 uppercase tracking-wider">
                <%= t("admin.organizations.tournaments") %>
              </th>
              <th class="px-6 py-3 text-left text-xs font-medium text-white/60 uppercase tracking-wider">
                <%= t("admin.organizations.created_at") %>
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/10">
            <% @organizations.each do |org| %>
              <tr class="hover:bg-white/5 transition">
                <td class="px-6 py-4">
                  <%= link_to org.name, admin_organization_path(org), class: "text-white font-medium hover:text-indigo-400" %>
                </td>
                <td class="px-6 py-4 text-white/80"><%= org.members_count %></td>
                <td class="px-6 py-4 text-white/80"><%= org.tournaments_count %></td>
                <td class="px-6 py-4 text-white/60"><%= l(org.created_at, format: :short) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>
