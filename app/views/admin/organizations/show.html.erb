<div>
  <%= render "admin/shared/navbar" %>

  <main class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
    <div class="px-4 sm:px-0">
      <%= link_to t("admin.back"), admin_organizations_path, class: "text-sm text-indigo-400 hover:text-indigo-300 mb-4 inline-block" %>

      <h1 class="text-2xl font-bold text-white mb-2"><%= @organization.name %></h1>
      <p class="text-white/60 mb-6"><%= t("admin.organizations.slug") %>: <%= @organization.slug %></p>

      <div class="grid gap-4 md:grid-cols-3 mb-8">
        <div class="card p-6">
          <p class="text-sm text-white/60"><%= t("admin.organizations.members") %></p>
          <p class="text-3xl font-bold text-white"><%= @members.count %></p>
        </div>
        <div class="card p-6">
          <p class="text-sm text-white/60"><%= t("admin.organizations.tournaments") %></p>
          <p class="text-3xl font-bold text-white"><%= @tournaments.count %></p>
        </div>
        <div class="card p-6">
          <p class="text-sm text-white/60"><%= t("admin.organizations.predictions") %></p>
          <p class="text-3xl font-bold text-white"><%= @predictions_count %></p>
        </div>
      </div>

      <div class="grid gap-6 lg:grid-cols-2">
        <div class="card p-6">
          <h2 class="text-lg font-medium text-white mb-4"><%= t("admin.organizations.members_list") %></h2>
          <div class="space-y-3">
            <% @members.each do |user| %>
              <%= link_to admin_user_path(user), class: "block p-3 rounded-lg bg-white/5 hover:bg-white/10 transition" do %>
                <p class="font-medium text-white"><%= user.display_name %></p>
                <p class="text-sm text-white/60"><%= user.email_address %></p>
              <% end %>
            <% end %>
          </div>
        </div>

        <div class="card p-6">
          <h2 class="text-lg font-medium text-white mb-4"><%= t("admin.organizations.tournaments_list") %></h2>
          <div class="space-y-3">
            <% @tournaments.each do |tournament| %>
              <div class="p-3 rounded-lg bg-white/5">
                <p class="font-medium text-white"><%= tournament.name %></p>
              </div>
            <% end %>
            <% if @tournaments.empty? %>
              <p class="text-white/50"><%= t("admin.organizations.no_tournaments") %></p>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>
