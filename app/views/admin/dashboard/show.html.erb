<div>
  <%= render "admin/shared/navbar" %>

  <main class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
    <div class="px-4 sm:px-0">
      <h1 class="text-2xl font-bold text-white mb-6"><%= t("admin.dashboard.title") %></h1>

      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4 mb-8">
        <div class="card p-6">
          <p class="text-sm text-white/60"><%= t("admin.dashboard.total_users") %></p>
          <p class="text-3xl font-bold text-white"><%= @stats[:total_users] %></p>
        </div>
        <div class="card p-6">
          <p class="text-sm text-white/60"><%= t("admin.dashboard.total_organizations") %></p>
          <p class="text-3xl font-bold text-white"><%= @stats[:total_organizations] %></p>
        </div>
        <div class="card p-6">
          <p class="text-sm text-white/60"><%= t("admin.dashboard.total_predictions") %></p>
          <p class="text-3xl font-bold text-white"><%= @stats[:total_predictions] %></p>
        </div>
        <div class="card p-6">
          <p class="text-sm text-white/60"><%= t("admin.dashboard.total_tournaments") %></p>
          <p class="text-3xl font-bold text-white"><%= @stats[:total_tournaments] %></p>
        </div>
      </div>

      <div class="grid gap-6 lg:grid-cols-2">
        <div class="card p-6">
          <div class="flex justify-between items-center mb-4">
            <h2 class="text-lg font-medium text-white"><%= t("admin.dashboard.recent_organizations") %></h2>
            <%= link_to t("admin.dashboard.view_all"), admin_organizations_path, class: "text-sm text-indigo-400 hover:text-indigo-300" %>
          </div>
          <div class="space-y-3">
            <% @recent_organizations.each do |org| %>
              <%= link_to admin_organization_path(org), class: "block p-3 rounded-lg bg-white/5 hover:bg-white/10 transition" do %>
                <p class="font-medium text-white"><%= org.name %></p>
                <p class="text-sm text-white/60"><%= l(org.created_at, format: :short) %></p>
              <% end %>
            <% end %>
          </div>
        </div>

        <div class="card p-6">
          <div class="flex justify-between items-center mb-4">
            <h2 class="text-lg font-medium text-white"><%= t("admin.dashboard.recent_users") %></h2>
            <%= link_to t("admin.dashboard.view_all"), admin_users_path, class: "text-sm text-indigo-400 hover:text-indigo-300" %>
          </div>
          <div class="space-y-3">
            <% @recent_users.each do |user| %>
              <%= link_to admin_user_path(user), class: "block p-3 rounded-lg bg-white/5 hover:bg-white/10 transition" do %>
                <p class="font-medium text-white"><%= user.display_name %></p>
                <p class="text-sm text-white/60"><%= user.email_address %></p>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>
