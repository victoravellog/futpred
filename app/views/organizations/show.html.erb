<div>
  <%= render "shared/navbar" %>

  <main class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
    <% if notice %>
      <div class="mb-4 alert-success"><%= notice %></div>
    <% end %>

    <div class="flex justify-between items-center mb-6">
      <div>
        <h1 class="text-2xl font-bold text-white"><%= @organization.name %></h1>
        <p class="text-white/60"><%= t("dashboard.members_count", count: @organization.users.count) %></p>
      </div>
      <div class="flex items-center space-x-3">
        <button type="button" onclick="navigator.clipboard.writeText('<%= invite_url(@organization.invite_token) %>');this.textContent='<%= t("invites.copied") %>'" class="btn-secondary">
          📋 <%= t("invites.copy_link") %>
        </button>
        <%= link_to t("organizations.new_tournament"), new_organization_tournament_path(@organization), class: "btn-primary" %>
      </div>
    </div>

    <% if @tournaments.any? %>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        <% @tournaments.each do |tournament| %>
          <%= link_to tournament_path(tournament, organization_id: @organization.id), class: "block card-interactive p-6" do %>
            <div class="flex items-center space-x-4">
              <% if tournament.logo_url.present? %>
                <img src="<%= tournament.logo_url %>" alt="<%= tournament.name %>" class="w-12 h-12 object-contain" onerror="this.style.display='none';this.nextElementSibling.style.display='inline'">
                <span class="text-4xl" style="display:none">🏆</span>
              <% else %>
                <span class="text-4xl">🏆</span>
              <% end %>
              <div>
                <h3 class="text-lg font-medium text-white"><%= tournament.name %></h3>
                <p class="text-sm text-white/60">
                  <%= t("tournaments.rounds_count", count: tournament.rounds.count) %> ·
                  <%= t("tournaments.fixtures_count", count: tournament.fixtures.count) %>
                </p>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state">
        <p class="text-white/50 mb-4"><%= t("organizations.no_tournaments") %></p>
        <%= link_to t("organizations.create_first_tournament"), new_organization_tournament_path(@organization), class: "btn-primary" %>
      </div>
    <% end %>
  </main>
</div>
