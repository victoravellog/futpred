<div class="min-h-screen bg-gray-50">
  <%= render "shared/navbar" %>

  <main class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
    <% if notice %>
      <div class="mb-4 bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded">
        <%= notice %>
      </div>
    <% end %>

    <div class="flex justify-between items-center mb-6">
      <div>
        <h1 class="text-2xl font-bold text-gray-900"><%= @organization.name %></h1>
        <p class="text-gray-500"><%= t("dashboard.members_count", count: @organization.users.count) %></p>
      </div>
      <div class="flex items-center space-x-3">
        <button type="button" onclick="navigator.clipboard.writeText('<%= invite_url(@organization.invite_token) %>');this.textContent='<%= t("invites.copied") %>'"
            class="inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
          📋 <%= t("invites.copy_link") %>
        </button>
        <%= link_to t("organizations.new_tournament"), new_organization_tournament_path(@organization),
            class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700" %>
      </div>
    </div>

    <% if @tournaments.any? %>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        <% @tournaments.each do |tournament| %>
          <%= link_to tournament_path(tournament), class: "block bg-white overflow-hidden shadow rounded-lg p-6 hover:shadow-md transition-shadow" do %>
            <div class="flex items-center space-x-4">
              <% if tournament.logo_url.present? %>
                <img src="<%= tournament.logo_url %>" alt="<%= tournament.name %>" class="w-12 h-12 object-contain" onerror="this.style.display='none';this.nextElementSibling.style.display='inline'">
                <span class="text-4xl" style="display:none">🏆</span>
              <% else %>
                <span class="text-4xl">🏆</span>
              <% end %>
              <div>
                <h3 class="text-lg font-medium text-gray-900"><%= tournament.name %></h3>
                <p class="text-sm text-gray-500">
                  <%= t("tournaments.rounds_count", count: tournament.rounds.count) %> ·
                  <%= t("tournaments.fixtures_count", count: tournament.fixtures.count) %>
                </p>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-12 bg-white rounded-lg shadow">
        <p class="text-gray-500 mb-4"><%= t("organizations.no_tournaments") %></p>
        <%= link_to t("organizations.create_first_tournament"), new_organization_tournament_path(@organization),
            class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700" %>
      </div>
    <% end %>
  </main>
</div>
