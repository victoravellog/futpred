<div>
  <%= render "shared/navbar" %>

  <main class="max-w-lg mx-auto py-12 px-4">
    <div class="card p-8">
      <h2 class="text-2xl font-bold text-white mb-6"><%= t("organizations.new") %></h2>

      <%= form_with model: @organization, class: "space-y-6" do |f| %>
        <% if @organization.errors.any? %>
          <div class="alert-error">
            <ul class="list-disc list-inside">
              <% @organization.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= f.label :name, t("organizations.name"), class: "block text-sm font-medium text-white/90" %>
          <%= f.text_field :name, required: true, autofocus: true, placeholder: t("organizations.name_placeholder"), class: "input mt-1" %>
          <p class="mt-1 text-sm text-white/50"><%= t("organizations.name_hint") %></p>
        </div>

        <div class="flex space-x-4">
          <%= link_to t("organizations.cancel"), root_path, class: "btn-secondary btn-lg flex-1 text-center" %>
          <%= f.submit t("organizations.create"), class: "btn-primary btn-lg flex-1" %>
        </div>
      <% end %>
    </div>
  </main>
</div>
