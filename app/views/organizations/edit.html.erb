<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<div>
  <%= render "shared/navbar" %>

  <main class="max-w-2xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
    <div class="mb-6">
      <%= link_to t("common.back"), @organization, class: "text-white/60 hover:text-white text-sm" %>
    </div>

    <div class="card p-6">
      <h1 class="text-xl font-bold text-white mb-6"><%= t("organizations.settings") %></h1>

      <%= form_with model: @organization, class: "space-y-6" do |f| %>
        <% if @organization.errors.any? %>
          <div class="alert-error">
            <ul>
              <% @organization.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= f.label :name, t("organizations.name"), class: "auth-label" %>
          <%= f.text_field :name, class: "auth-input", placeholder: t("organizations.name_placeholder") %>
        </div>

        <div>
          <label class="auth-label"><%= t("organizations.locale") %></label>
          <p class="text-white/50 text-sm mb-3"><%= t("organizations.locale_hint") %></p>
          <div class="flex gap-4">
            <label class="flex items-center gap-2 cursor-pointer">
              <%= f.radio_button :locale, "es", class: "w-4 h-4 accent-indigo-500" %>
              <span class="text-white">Español</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <%= f.radio_button :locale, "en", class: "w-4 h-4 accent-indigo-500" %>
              <span class="text-white">English</span>
            </label>
          </div>
        </div>

        <div class="flex gap-3">
          <%= f.submit t("organizations.save"), class: "btn-primary" %>
          <%= link_to t("organizations.cancel"), @organization, class: "btn-secondary" %>
        </div>
      <% end %>
    </div>
  </main>
</div>
