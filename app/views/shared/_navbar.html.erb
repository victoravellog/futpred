<nav class="bg-white/10 backdrop-blur-md border-b border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-16">
      <div class="flex items-center space-x-8">
        <%= link_to root_path, class: "inline-block w-fit" do %>
          <%= image_tag "futpred-logo-navbar.svg", alt: t("app_name"), class: "h-14 w-auto drop-shadow" %>
        <% end %>
        <div class="hidden md:flex items-center space-x-4">
          <% Current.user.organizations.limit(3).each do |org| %>
            <%= link_to org.name, organization_path(org), class: "text-white/70 hover:text-white transition-colors" %>
          <% end %>
          <%= link_to new_organization_path, class: "text-white/40 hover:text-white transition-colors", title: t("nav.new_organization") do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
            </svg>
          <% end %>
        </div>
      </div>
      <div class="flex items-center space-x-4">
        <%= link_to profile_path, class: "flex items-center space-x-2 hover:opacity-80 transition-opacity" do %>
          <% if Current.user.avatar.attached? %>
            <%= image_tag Current.user.avatar, class: "w-8 h-8 rounded-full object-cover border border-white/20" %>
          <% elsif Current.user.avatar_emoji %>
            <div class="w-8 h-8 rounded-full bg-white/20 border border-white/20 flex items-center justify-center">
              <span class="text-lg"><%= Current.user.avatar_emoji %></span>
            </div>
          <% else %>
            <div class="w-8 h-8 rounded-full bg-white/20 border border-white/20 flex items-center justify-center">
              <span class="text-sm text-white/80"><%= Current.user.display_name[0].upcase %></span>
            </div>
          <% end %>
          <span class="text-white/80 text-sm hidden sm:inline"><%= Current.user.display_name %></span>
        <% end %>
        <%= button_to t("nav.logout"), session_path, method: :delete, class: "text-sm text-white/50 hover:text-white transition-colors" %>
      </div>
    </div>
  </div>
</nav>
