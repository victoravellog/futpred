<div class="min-h-screen flex items-center justify-center relative bg-slate-900">
  <%# Background image with blur %>
  <div class="absolute inset-0 z-0 bg-slate-900">
    <%= image_tag "bg-stadium.jpg", class: "w-full h-full object-cover blur-sm scale-105", loading: "eager" %>
    <div class="absolute inset-0 bg-black/40"></div>
  </div>

  <%# Content - 2 columns %>
  <div class="relative z-10 flex flex-col lg:flex-row items-center gap-12 lg:gap-24 px-6 py-12 max-w-5xl mx-auto">
    <%# Left - Logo (links to landing) %>
    <div class="flex items-center justify-center lg:w-80 shrink-0">
      <%= link_to root_path do %>
        <%= image_tag "futpred-logo.svg", alt: t("app_name"), class: "h-56 lg:h-96 w-auto drop-shadow-lg hover:scale-105 transition-transform" %>
      <% end %>
    </div>

    <%# Right - Form %>
    <div class="w-full lg:w-96 shrink-0">
      <div class="text-center lg:text-left mb-6">
        <h1 class="text-3xl font-bold text-white drop-shadow-lg"><%= title %></h1>
        <% if local_assigns[:subtitle] %>
          <p class="mt-2 text-sm text-white/80"><%= subtitle %></p>
        <% end %>
      </div>

      <% if flash[:alert] %>
        <div class="mb-4 alert-error"><%= flash[:alert] %></div>
      <% end %>

      <% if flash[:notice] %>
        <div class="mb-4 alert-success"><%= flash[:notice] %></div>
      <% end %>

      <%= yield %>
    </div>
  </div>
</div>
