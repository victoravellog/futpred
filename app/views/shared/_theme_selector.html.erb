<div id="theme-selector" class="relative" data-controller="dropdown">
  <button type="button"
          class="p-2 rounded-lg text-white/70 hover:text-white hover:bg-white/10 transition-colors"
          data-action="dropdown#toggle"
          title="<%= t('profile.theme') %>">
    <%# Palette icon %>
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
    </svg>
  </button>

  <div data-dropdown-target="menu" class="hidden absolute right-0 mt-2 rounded-lg shadow-xl z-50 p-2 theme-dropdown">
    <div class="flex gap-1">
      <% User::THEMES.each do |theme| %>
        <%= button_to theme_path,
              method: :patch,
              params: { theme: theme },
              class: "p-2 rounded-lg transition-colors #{Current.user.theme == theme ? 'theme-selected' : 'theme-option'}",
              title: t("profile.themes.#{theme}"),
              data: { controller: "theme", theme_theme_value: theme, action: "click->theme#switch" } do %>
          <% case theme %>
          <% when "dark" %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
          <% when "light" %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
          <% when "pitch" %>
            <%# Football pitch icon %>
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="4" width="20" height="16" rx="1" />
              <line x1="12" y1="4" x2="12" y2="20" />
              <circle cx="12" cy="12" r="3" />
            </svg>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
