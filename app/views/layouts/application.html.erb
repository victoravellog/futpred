<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <%= display_meta_tags site: "FutPred",
                          separator: "—",
                          reverse: true,
                          viewport: "width=device-width,initial-scale=1",
                          og: {
                            site_name: "FutPred",
                            type: "website",
                            locale: I18n.locale == :es ? "es_ES" : "en_US"
                          },
                          twitter: {
                            card: "summary_large_image"
                          } %>
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="canonical" href="<%= request.original_url.split('?').first %>">

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="min-h-screen flex flex-col bg-linear-to-br from-slate-900 via-slate-800 to-indigo-950">
    <div class="flex-1">
      <%= yield %>
    </div>
    <%= render "shared/footer" %>
  </body>
</html>
