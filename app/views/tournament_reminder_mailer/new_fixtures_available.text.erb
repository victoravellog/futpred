<% I18n.with_locale(@locale) do %>
<%= t("mailer.tournament_reminder.greeting", name: @user.display_name) %>

<%= t("mailer.tournament_reminder.new_fixtures_body", tournament: @tournament.name, count: @new_fixtures_count) %>

<% if @next_fixture %>
<%= t("mailer.tournament_reminder.next_match",
      date: l(@next_fixture.kickoff_at, format: :long),
      home: @next_fixture.home_team&.name,
      away: @next_fixture.away_team&.name) %>
<% end %>

<%= t("mailer.tournament_reminder.cta_predict") %>: <%= root_url %>

<%= t("mailer.tournament_reminder.good_luck") %>

<%= t("mailer.tournament_reminder.signature") %>
<% end %>
