<% I18n.with_locale(@locale) do %>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0">
  <!-- Tournament Logo -->
  <% if @tournament.respond_to?(:logo_url) && @tournament.logo_url.present? %>
  <tr>
    <td align="center" style="padding: 0 0 24px;">
      <img src="<%= @tournament.logo_url %>" alt="<%= @tournament.name %>" height="64" style="display: block;">
    </td>
  </tr>
  <% end %>

  <!-- Greeting -->
  <tr>
    <td style="padding: 0 0 16px;">
      <h1 style="margin: 0; font-size: 24px; font-weight: 700; color: #ffffff;">
        <%= t("mailer.tournament_reminder.greeting", name: @user.display_name) %>
      </h1>
    </td>
  </tr>

  <!-- Main Message -->
  <tr>
    <td style="padding: 0 0 24px;">
      <% case @reminder_type %>
      <% when :month_start %>
        <p style="margin: 0 0 12px; font-size: 18px; line-height: 1.6; color: rgba(255,255,255,0.9);">
          <%= t("mailer.tournament_reminder.month_start_body", month: @current_month, tournament: @tournament.name) %>
        </p>
        <p style="margin: 0; font-size: 16px; line-height: 1.6; color: rgba(255,255,255,0.7);">
          <%= t("mailer.tournament_reminder.month_start_days", days: @days_until) %>
        </p>
      <% when :one_week %>
        <p style="margin: 0 0 12px; font-size: 18px; line-height: 1.6; color: rgba(255,255,255,0.9);">
          <%= t("mailer.tournament_reminder.one_week_body", tournament: @tournament.name) %>
        </p>
        <p style="margin: 0; font-size: 16px; line-height: 1.6; color: rgba(255,255,255,0.7);">
          <%= t("mailer.tournament_reminder.one_week_hint") %>
        </p>
      <% when :one_day %>
        <p style="margin: 0 0 12px; font-size: 18px; line-height: 1.6; color: rgba(255,255,255,0.9);">
          <%= t("mailer.tournament_reminder.one_day_body", tournament: @tournament.name) %>
        </p>
        <p style="margin: 0; font-size: 16px; line-height: 1.6; color: rgba(255,255,255,0.7);">
          <%= t("mailer.tournament_reminder.one_day_hint") %>
        </p>
      <% else %>
        <p style="margin: 0; font-size: 18px; line-height: 1.6; color: rgba(255,255,255,0.9);">
          <%= t("mailer.tournament_reminder.soon_body", tournament: @tournament.name) %>
        </p>
      <% end %>
    </td>
  </tr>

  <!-- CTA Button -->
  <tr>
    <td style="padding: 0 0 32px;">
      <table role="presentation" cellspacing="0" cellpadding="0">
        <tr>
          <td style="border-radius: 12px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); box-shadow: 0 4px 14px rgba(16, 185, 129, 0.4);">
            <a href="<%= root_url %>" target="_blank" style="display: inline-block; padding: 16px 32px; font-size: 16px; font-weight: 600; color: #ffffff; text-decoration: none;">
              <%= t("mailer.tournament_reminder.cta") %> →
            </a>
          </td>
        </tr>
      </table>
    </td>
  </tr>

  <!-- Good Luck -->
  <tr>
    <td>
      <p style="margin: 0; font-size: 16px; color: rgba(255,255,255,0.7);">
        <%= t("mailer.tournament_reminder.good_luck") %> ⚽
      </p>
      <p style="margin: 8px 0 0; font-size: 14px; color: rgba(255,255,255,0.5);">
        <%= t("mailer.tournament_reminder.signature") %>
      </p>
    </td>
  </tr>
</table>
<% end %>
