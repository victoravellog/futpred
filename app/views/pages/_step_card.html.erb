<div class="relative text-center group">
  <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-emerald-500/20 text-emerald-400 mb-6 group-hover:scale-110 transition-transform">
    <%= icon %>
  </div>
  <span class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-2 text-6xl font-bold text-white/5"><%= number %></span>
  <h3 class="text-xl font-semibold text-white mb-3"><%= title %></h3>
  <p class="text-white/60"><%= description %></p>
</div>
