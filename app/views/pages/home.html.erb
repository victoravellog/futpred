<div class="min-h-screen">
  <%# Navbar %>
  <nav class="landing-nav" data-controller="mobile-menu">
    <div class="section-container">
      <div class="flex items-center justify-between h-16">
        <div class="flex items-center gap-8">
          <%= image_tag "futpred-logo-dark.svg", alt: "FutPred", class: "h-8" %>
          <div class="hidden md:flex items-center gap-6">
            <a href="#como-funciona" class="nav-link"><%= t("landing.nav.how_it_works") %></a>
            <%= link_to t("landing.nav.for_companies"), pricing_path, class: "nav-link" %>
          </div>
        </div>

        <%# Desktop nav %>
        <div class="hidden sm:flex items-center gap-4">
          <div class="flex items-center gap-1 text-sm">
            <%= link_to "ES", localized_root_path(locale: :es), class: "px-2 py-1 rounded #{I18n.locale == :es ? 'text-white font-medium' : 'text-white/50 hover:text-white'} transition-colors" %>
            <span class="text-white/30">|</span>
            <%= link_to "EN", localized_root_path(locale: :en), class: "px-2 py-1 rounded #{I18n.locale == :en ? 'text-white font-medium' : 'text-white/50 hover:text-white'} transition-colors" %>
          </div>
          <%= link_to t("landing.nav.sign_in"), new_session_path, class: "nav-link" %>
          <%= link_to t("landing.nav.create_group"), new_registration_path, class: "btn-landing" %>
        </div>

        <%# Mobile hamburger %>
        <button type="button" class="sm:hidden text-2xl p-2 transition-transform duration-300" data-action="mobile-menu#toggle" data-mobile-menu-target="button">
          ⚽
        </button>
      </div>

      <%# Mobile menu %>
      <div data-mobile-menu-target="menu" class="hidden sm:hidden pb-4 border-t border-white/10 mt-2 pt-4">
        <div class="flex flex-col gap-4">
          <a href="#como-funciona" class="nav-link" data-action="click->mobile-menu#close"><%= t("landing.nav.how_it_works") %></a>
          <%= link_to t("landing.nav.for_companies"), pricing_path, class: "nav-link", data: { action: "click->mobile-menu#close" } %>
          <%= link_to t("landing.nav.sign_in"), new_session_path, class: "nav-link" %>
          <div class="flex items-center gap-2 text-sm">
            <%= link_to "ES", localized_root_path(locale: :es), class: "px-2 py-1 rounded #{I18n.locale == :es ? 'text-white font-medium' : 'text-white/50 hover:text-white'} transition-colors" %>
            <span class="text-white/30">|</span>
            <%= link_to "EN", localized_root_path(locale: :en), class: "px-2 py-1 rounded #{I18n.locale == :en ? 'text-white font-medium' : 'text-white/50 hover:text-white'} transition-colors" %>
          </div>
          <%= link_to t("landing.nav.create_group"), new_registration_path, class: "btn-landing text-center" %>
        </div>
      </div>
    </div>
  </nav>

  <%# Hero %>
  <section class="relative pt-32 pb-20 lg:pt-40 lg:pb-32 overflow-hidden">
    <div class="absolute inset-0 z-0">
      <%= image_tag "bg-stadium.jpg", class: "w-full h-full object-cover opacity-30", loading: "eager" %>
      <div class="absolute inset-0 bg-gradient-to-b from-slate-900/50 via-slate-900/80 to-slate-900"></div>
    </div>

    <div class="section-container relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <span class="badge badge-lg mb-6">
          <%= render "pages/ping_indicator" %>
          <%= t("landing.hero.badge") %>
        </span>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white leading-tight mb-6">
          <%= t("landing.hero.headline") %>
        </h1>

        <p class="text-lg sm:text-xl text-white/70 mb-10 max-w-2xl mx-auto">
          <%= t("landing.hero.subtitle") %>
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <%= link_to new_registration_path, class: "w-full sm:w-auto btn-landing btn-lg px-8 rounded-xl shadow-lg shadow-emerald-600/25 hover:scale-105" do %>
            <%= t("landing.hero.cta_primary") %>
            <%= render "shared/icons/icon_arrow_right" %>
          <% end %>
          <a href="#como-funciona" class="w-full sm:w-auto btn-landing-secondary btn-lg px-8">
            <%= t("landing.hero.cta_secondary") %>
          </a>
        </div>
      </div>
    </div>
  </section>

  <%# Cómo funciona %>
  <section id="como-funciona" class="section-alt">
    <div class="section-container">
      <div class="section-header">
        <h2 class="section-title"><%= t("landing.how_it_works.title") %></h2>
        <p class="section-subtitle"><%= t("landing.how_it_works.subtitle") %></p>
      </div>

      <div class="grid md:grid-cols-3 gap-8 lg:gap-12">
        <%= render "pages/step_card",
            number: 1,
            icon: capture { %>
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
              </svg>
            <% },
            title: t("landing.how_it_works.step1_title"),
            description: t("landing.how_it_works.step1_description") %>

        <%= render "pages/step_card",
            number: 2,
            icon: capture { %>
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
              </svg>
            <% },
            title: t("landing.how_it_works.step2_title"),
            description: t("landing.how_it_works.step2_description") %>

        <%= render "pages/step_card",
            number: 3,
            icon: capture { %>
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
              </svg>
            <% },
            title: t("landing.how_it_works.step3_title"),
            description: t("landing.how_it_works.step3_description") %>
      </div>
    </div>
  </section>

  <%# Caso de éxito %>
  <section class="section">
    <div class="section-container">
      <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-emerald-600/20 to-emerald-900/20 border border-emerald-500/20 p-8 lg:p-12">
        <div class="absolute top-0 right-0 -translate-y-1/4 translate-x-1/4 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl"></div>

        <div class="relative grid lg:grid-cols-2 gap-8 items-center">
          <div>
            <span class="badge mb-4"><%= t("landing.success_story.badge") %></span>
            <h3 class="text-2xl sm:text-3xl font-bold text-white mb-4">
              <%= t("landing.success_story.quote") %>
            </h3>
            <p class="text-white/70 mb-6">
              <%= raw t("landing.success_story.description_html") %>
            </p>
            <div class="flex items-center gap-6 text-sm">
              <div>
                <div class="stat-value"><%= t("landing.success_story.stat1_value") %></div>
                <div class="stat-label"><%= t("landing.success_story.stat1_label") %></div>
              </div>
              <div class="stat-divider"></div>
              <div>
                <div class="stat-value"><%= t("landing.success_story.stat2_value") %></div>
                <div class="stat-label"><%= t("landing.success_story.stat2_label") %></div>
              </div>
              <div class="stat-divider"></div>
              <div>
                <div class="stat-value"><%= t("landing.success_story.stat3_value") %></div>
                <div class="stat-label"><%= t("landing.success_story.stat3_label") %></div>
              </div>
            </div>
          </div>
          <div class="hidden lg:flex items-center justify-center">
            <div class="relative">
              <div class="absolute inset-0 bg-emerald-500/20 rounded-2xl blur-xl"></div>
              <div class="card p-6">
                <div class="flex items-center gap-3 mb-4">
                  <div class="w-10 h-10 rounded-full bg-emerald-500/20 flex items-center justify-center text-emerald-400 font-bold">🏆</div>
                  <div>
                    <div class="text-sm font-medium text-white"><%= t("landing.success_story.leaderboard_title") %></div>
                    <div class="text-xs text-white/50"><%= t("landing.success_story.leaderboard_tournament") %></div>
                  </div>
                </div>
                <div class="space-y-2">
                  <div class="flex items-center gap-3 p-2 rounded-lg bg-emerald-500/10">
                    <span class="text-lg">🥇</span>
                    <span class="text-white text-sm flex-1">María G.</span>
                    <span class="text-emerald-400 font-semibold text-sm">127 pts</span>
                  </div>
                  <div class="flex items-center gap-3 p-2 rounded-lg bg-white/5">
                    <span class="text-lg">🥈</span>
                    <span class="text-white/80 text-sm flex-1">Carlos R.</span>
                    <span class="text-white/60 font-semibold text-sm">119 pts</span>
                  </div>
                  <div class="flex items-center gap-3 p-2 rounded-lg bg-white/5">
                    <span class="text-lg">🥉</span>
                    <span class="text-white/80 text-sm flex-1">Ana P.</span>
                    <span class="text-white/60 font-semibold text-sm">112 pts</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%# Para quién es %>
  <section id="empresas" class="section-alt">
    <div class="section-container">
      <div class="section-header">
        <h2 class="section-title"><%= t("landing.audience.title") %></h2>
        <p class="section-subtitle"><%= t("landing.audience.subtitle") %></p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <%= render "pages/audience_card",
            icon_bg: "bg-blue-500/20",
            icon: capture { %>
              <svg class="w-7 h-7 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            <% },
            title: t("landing.audience.companies.title"),
            description: t("landing.audience.companies.description"),
            features: [
              t("landing.audience.companies.feature1"),
              t("landing.audience.companies.feature2"),
              t("landing.audience.companies.feature3")
            ],
            cta_text: t("landing.audience.companies.cta"),
            cta_path: pricing_path %>

        <%= render "pages/audience_card",
            icon_bg: "bg-amber-500/20",
            icon: capture { %>
              <svg class="w-7 h-7 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            <% },
            title: t("landing.audience.friends.title"),
            description: t("landing.audience.friends.description"),
            features: [
              t("landing.audience.friends.feature1"),
              t("landing.audience.friends.feature2"),
              t("landing.audience.friends.feature3")
            ] %>

        <%= render "pages/audience_card",
            icon_bg: "bg-purple-500/20",
            icon: capture { %>
              <svg class="w-7 h-7 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9" />
              </svg>
            <% },
            title: t("landing.audience.clubs.title"),
            description: t("landing.audience.clubs.description"),
            features: [
              t("landing.audience.clubs.feature1"),
              t("landing.audience.clubs.feature2"),
              t("landing.audience.clubs.feature3")
            ] %>
      </div>
    </div>
  </section>

  <%# CTA Final %>
  <section class="section">
    <div class="section-container">
      <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-emerald-600 to-emerald-700 p-12 lg:p-16 text-center">
        <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-30"></div>

        <div class="relative">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-6">
            <%= t("landing.cta.title") %>
          </h2>
          <p class="text-lg sm:text-xl text-white/80 mb-10 max-w-2xl mx-auto">
            <%= t("landing.cta.subtitle") %>
          </p>
          <%= link_to new_registration_path, class: "inline-flex items-center justify-center px-10 py-4 text-lg font-semibold rounded-xl bg-white text-emerald-700 hover:bg-white/90 transition-all hover:scale-105 shadow-xl" do %>
            <%= t("landing.cta.button") %>
            <%= render "shared/icons/icon_arrow_right" %>
          <% end %>
        </div>
      </div>
    </div>
  </section>
</div>
