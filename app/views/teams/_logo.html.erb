<% if team.country_code.present? %>
  <span class="text-xl"><%= country_flag(team.country_code) %></span>
<% elsif team.logo_url.present? %>
  <img src="<%= team.logo_url %>" alt="<%= team.name %>" class="w-6 h-6 object-contain" onerror="this.style.display='none';this.nextElementSibling.style.display='inline'">
  <span class="text-xl" style="display:none">⚽</span>
<% else %>
  <span class="text-xl">⚽</span>
<% end %>
