<div class="min-h-screen bg-gray-50">
  <%= render "shared/navbar" %>

  <main class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
    <% if notice %>
      <div class="mb-4 bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded">
        <%= notice %>
      </div>
    <% end %>

    <div class="mb-6 flex justify-between items-start">
      <div>
        <h1 class="text-2xl font-bold text-gray-900"><%= @tournament.name %></h1>
        <p class="text-gray-500"><%= @tournament.organization.name %></p>
      </div>
      <%= link_to tournament_leaderboard_path(@tournament),
          class: "inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50" do %>
        <svg class="w-5 h-5 mr-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
        </svg>
        Clasificación
      <% end %>
    </div>

    <details class="mb-6 bg-white rounded-lg shadow">
      <summary class="px-4 py-3 cursor-pointer text-sm font-medium text-gray-700 hover:bg-gray-50 rounded-lg">
        ¿Cómo se calculan los puntos?
      </summary>
      <div class="px-4 pb-4 pt-2 border-t border-gray-100">
        <p class="text-sm text-gray-600 mb-3">Si el resultado real es <span class="font-semibold">Argentina 2 - 1 Brasil</span>:</p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm">
          <div class="bg-green-50 rounded-lg p-3">
            <div class="font-semibold text-green-700">5 puntos</div>
            <div class="text-green-600">Predijiste 2 - 1</div>
            <div class="text-xs text-green-500 mt-1">Resultado exacto</div>
          </div>
          <div class="bg-blue-50 rounded-lg p-3">
            <div class="font-semibold text-blue-700">3 puntos</div>
            <div class="text-blue-600">Predijiste 3 - 0</div>
            <div class="text-xs text-blue-500 mt-1">Acertaste quién gana</div>
          </div>
          <div class="bg-gray-100 rounded-lg p-3">
            <div class="font-semibold text-gray-700">0 puntos</div>
            <div class="text-gray-600">Predijiste 0 - 2</div>
            <div class="text-xs text-gray-500 mt-1">No acertaste</div>
          </div>
        </div>
        <p class="text-xs text-gray-500 mt-3">Los puntos se multiplican según la fase: Grupos x1, Cuartos x1.5, Semis x1.75, Final x2</p>
      </div>
    </details>

    <% if @rounds.any? %>
      <div class="space-y-8">
        <% @rounds.each do |round| %>
          <div class="bg-white shadow rounded-lg overflow-hidden">
            <div class="bg-gray-50 px-6 py-4 border-b border-gray-200">
              <div class="flex justify-between items-center">
                <h2 class="text-lg font-medium text-gray-900"><%= round.name %></h2>
                <span class="text-sm text-gray-500">x<%= round.scoring_multiplier %> puntos</span>
              </div>
            </div>

            <div class="divide-y divide-gray-200">
              <% round.fixtures.each do |fixture| %>
                <%= render "fixtures/fixture_row", fixture: fixture %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-12 bg-white rounded-lg shadow">
        <p class="text-gray-500">No hay partidos cargados en este torneo todavía.</p>
      </div>
    <% end %>
  </main>
</div>
