<div class="min-h-screen bg-gray-50">
  <%= render "shared/navbar" %>

  <main class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
    <% if notice %>
      <div class="mb-4 bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded">
        <%= notice %>
      </div>
    <% end %>

    <div class="mb-6 flex justify-between items-start">
      <div>
        <h1 class="text-2xl font-bold text-gray-900"><%= @tournament.name %></h1>
        <p class="text-lg text-indigo-600 font-semibold"><%= t("tournaments.your_points", points: @user_points || 0) %></p>
      </div>
      <%= link_to tournament_leaderboard_path(@tournament),
          class: "inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50" do %>
        <svg class="w-5 h-5 mr-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
        </svg>
        <%= t("tournaments.leaderboard") %>
      <% end %>
    </div>

    <details class="mb-6 bg-white rounded-lg shadow">
      <summary class="px-4 py-3 cursor-pointer text-sm font-medium text-gray-700 hover:bg-gray-50 rounded-lg">
        <%= t("scoring.title") %>
      </summary>
      <div class="px-4 pb-4 pt-2 border-t border-gray-100">
        <p class="text-sm text-gray-600 mb-3"><%= t("scoring.example_intro", home_team: "Argentina", home_score: 2, away_score: 1, away_team: "Brasil") %></p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm">
          <div class="bg-green-50 rounded-lg p-3">
            <div class="font-semibold text-green-700"><%= t("scoring.points_5") %></div>
            <div class="text-green-600"><%= t("scoring.predicted", home: 2, away: 1) %></div>
            <div class="text-xs text-green-500 mt-1"><%= t("scoring.exact_score") %></div>
          </div>
          <div class="bg-blue-50 rounded-lg p-3">
            <div class="font-semibold text-blue-700"><%= t("scoring.points_3") %></div>
            <div class="text-blue-600"><%= t("scoring.predicted", home: 3, away: 0) %></div>
            <div class="text-xs text-blue-500 mt-1"><%= t("scoring.correct_result") %></div>
          </div>
          <div class="bg-gray-100 rounded-lg p-3">
            <div class="font-semibold text-gray-700"><%= t("scoring.points_0") %></div>
            <div class="text-gray-600"><%= t("scoring.predicted", home: 0, away: 2) %></div>
            <div class="text-xs text-gray-500 mt-1"><%= t("scoring.wrong") %></div>
          </div>
        </div>
        <p class="text-xs text-gray-500 mt-3"><%= t("scoring.multiplier_note") %></p>
      </div>
    </details>

    <% if @rounds.any? %>
      <div class="space-y-8">
        <% @rounds.each do |round| %>
          <div class="bg-white shadow rounded-lg overflow-hidden">
            <div class="bg-gray-50 px-6 py-4 border-b border-gray-200">
              <div class="flex justify-between items-center">
                <h2 class="text-lg font-medium text-gray-900"><%= round.name %></h2>
                <span class="text-sm text-gray-500"><%= t("tournaments.points_multiplier", multiplier: round.scoring_multiplier) %></span>
              </div>
            </div>

            <% if round.fixtures.count > 10 %>
              <% round.fixtures.order(:kickoff_at).group_by { |f| f.kickoff_at.to_date }.each do |date, fixtures| %>
                <details class="group">
                  <summary class="px-6 py-3 bg-gray-100 cursor-pointer hover:bg-gray-200 flex justify-between items-center">
                    <span class="font-medium text-gray-700"><%= l(date, format: :long) %></span>
                    <span class="text-sm text-gray-500"><%= t("tournaments.fixtures_count", count: fixtures.count) %></span>
                  </summary>
                  <div class="divide-y divide-gray-200">
                    <% fixtures.each do |fixture| %>
                      <%= render "fixtures/fixture_row", fixture: fixture %>
                    <% end %>
                  </div>
                </details>
              <% end %>
            <% else %>
              <div class="divide-y divide-gray-200">
                <% round.fixtures.order(:kickoff_at).each do |fixture| %>
                  <%= render "fixtures/fixture_row", fixture: fixture %>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-12 bg-white rounded-lg shadow">
        <p class="text-gray-500"><%= t("tournaments.no_fixtures") %></p>
      </div>
    <% end %>
  </main>
</div>
