<div>
  <%= render "shared/navbar" %>

  <main class="max-w-6xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
    <% if notice %>
      <div class="mb-4 alert-success"><%= notice %></div>
    <% end %>

    <div class="mb-6 flex justify-between items-start">
      <div>
        <h1 class="text-2xl font-bold text-white"><%= @tournament.name %></h1>
        <p class="text-lg text-indigo-400 font-semibold"><%= t("tournaments.your_points", points: @user_points || 0) %></p>
      </div>
      <%= link_to tournament_leaderboard_path(@tournament, organization_id: @organization.id), class: "btn-secondary" do %>
        <svg class="w-5 h-5 mr-2 text-white/70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
        </svg>
        <%= t("tournaments.leaderboard") %>
      <% end %>
    </div>

    <details class="mb-6 bg-white/5 backdrop-blur-sm rounded-lg border border-white/10">
      <summary class="px-4 py-3 cursor-pointer text-sm font-medium text-white/80 hover:bg-white/5 rounded-lg">
        <%= t("scoring.title") %>
      </summary>
      <div class="px-4 pb-4 pt-2 border-t border-white/10">
        <p class="text-sm text-white/60 mb-3"><%= t("scoring.example_intro", home_team: "Argentina", home_score: 2, away_score: 1, away_team: "Brasil") %></p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm">
          <div class="bg-green-500/20 backdrop-blur-sm rounded-lg p-3 border border-green-400/30">
            <div class="font-semibold text-green-400"><%= t("scoring.points_5") %></div>
            <div class="text-green-300/80"><%= t("scoring.predicted", home: 2, away: 1) %></div>
            <div class="text-xs text-green-400/60 mt-1"><%= t("scoring.exact_score") %></div>
          </div>
          <div class="bg-blue-500/20 backdrop-blur-sm rounded-lg p-3 border border-blue-400/30">
            <div class="font-semibold text-blue-400"><%= t("scoring.points_3") %></div>
            <div class="text-blue-300/80"><%= t("scoring.predicted", home: 3, away: 0) %></div>
            <div class="text-xs text-blue-400/60 mt-1"><%= t("scoring.correct_result") %></div>
          </div>
          <div class="bg-white/10 backdrop-blur-sm rounded-lg p-3 border border-white/20">
            <div class="font-semibold text-white/80"><%= t("scoring.points_0") %></div>
            <div class="text-white/60"><%= t("scoring.predicted", home: 0, away: 2) %></div>
            <div class="text-xs text-white/40 mt-1"><%= t("scoring.wrong") %></div>
          </div>
        </div>
        <p class="text-xs text-white/40 mt-3"><%= t("scoring.multiplier_note") %></p>
      </div>
    </details>

    <% if @rounds.any? %>
      <%
        today = Date.current
        tomorrow = today + 1.day
        all_fixtures = @rounds.flat_map { |r| r.fixtures.to_a }
        pending_fixtures = all_fixtures.reject(&:finished?).sort_by(&:kickoff_at)

        featured_fixtures = pending_fixtures.select { |f| f.kickoff_at.to_date.between?(today, tomorrow) }

        if featured_fixtures.empty? && pending_fixtures.any?
          next_date = pending_fixtures.first.kickoff_at.to_date
          featured_fixtures = pending_fixtures.select { |f| f.kickoff_at.to_date == next_date }
        end

        has_featured = featured_fixtures.any?
        featured_date = featured_fixtures.first&.kickoff_at&.to_date
      %>

      <% if has_featured %>
        <div class="mb-8">
          <h2 class="text-lg font-semibold text-white mb-4 flex items-center gap-2">
            <span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></span>
            <% if featured_date == today %>
              <%= t("tournaments.today") %>
            <% elsif featured_date == tomorrow %>
              <%= t("tournaments.tomorrow") %>
            <% else %>
              <%= l(featured_date, format: :long) %>
            <% end %>
          </h2>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-2">
            <% featured_fixtures.first(6).each do |fixture| %>
              <%= render "fixtures/fixture_card", fixture: fixture %>
            <% end %>
          </div>
          <% if featured_fixtures.size > 6 %>
            <p class="text-sm text-white/50 mt-3 text-center">
              <%= t("tournaments.more_matches", count: featured_fixtures.size - 6) %>
            </p>
          <% end %>
        </div>
      <% end %>

      <div class="space-y-6">
        <% @rounds.each do |round| %>
          <div class="bg-white/5 backdrop-blur-sm rounded-lg overflow-hidden border border-white/10">
            <div class="bg-white/5 px-4 py-3 border-b border-white/10">
              <div class="flex justify-between items-center">
                <h2 class="font-medium text-white"><%= round.name %></h2>
                <span class="text-xs text-white/50"><%= t("tournaments.points_multiplier", multiplier: round.scoring_multiplier) %></span>
              </div>
            </div>

            <% fixtures_by_date = round.fixtures.order(:kickoff_at).group_by { |f| f.kickoff_at.to_date } %>
            <% fixtures_by_date.each do |date, fixtures| %>
              <details class="group" <%= "open" if date.between?(today, tomorrow) %>>
                <summary class="px-4 py-2 bg-white/5 cursor-pointer hover:bg-white/10 flex justify-between items-center text-sm transition-colors">
                  <span class="font-medium text-white/80">
                    <% if date == today %>
                      <span class="text-green-400"><%= t("tournaments.today") %></span> -
                    <% elsif date == tomorrow %>
                      <span class="text-blue-400"><%= t("tournaments.tomorrow") %></span> -
                    <% end %>
                    <%= l(date, format: :long) %>
                  </span>
                  <span class="text-xs text-white/50"><%= t("tournaments.fixtures_count", count: fixtures.count) %></span>
                </summary>
                <div class="divide-y divide-white/5">
                  <% fixtures.each do |fixture| %>
                    <%= render "fixtures/fixture_compact", fixture: fixture %>
                  <% end %>
                </div>
              </details>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state">
        <p class="text-white/50"><%= t("tournaments.no_fixtures") %></p>
      </div>
    <% end %>
  </main>
</div>
