<div
  <%= render "shared/navbar" %>

  <main class="max-w-4xl mx-auto py-12 px-4">
    <div class="mb-8">
      <h2 class="text-2xl font-bold text-white"><%= t("tournaments.add_tournament") %></h2>
      <p class="mt-2 text-white/60"><%= t("tournaments.select_to_add") %></p>
    </div>

    <% if @available_tournaments.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @available_tournaments.each do |tournament| %>
          <div class="card-interactive">
            <div class="p-6">
              <div class="flex items-center space-x-4">
                <% if tournament.logo_url.present? %>
                  <img src="<%= tournament.logo_url %>" alt="<%= tournament.name %>" class="w-16 h-16 object-contain" onerror="this.style.display='none';this.nextElementSibling.style.display='inline'">
                  <span class="text-5xl" style="display:none">🏆</span>
                <% else %>
                  <span class="text-5xl">🏆</span>
                <% end %>
                <div class="flex-1">
                  <h3 class="text-lg font-semibold text-white"><%= tournament.name %></h3>
                </div>
              </div>
              <div class="mt-4">
                <%= button_to t("tournaments.add"), organization_tournaments_path(@organization, tournament_id: tournament.id),
                    method: :post,
                    class: "btn-primary w-full" %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="card p-8 text-center">
        <span class="text-5xl">✅</span>
        <h3 class="mt-4 text-lg font-medium text-white"><%= t("tournaments.all_added") %></h3>
        <p class="mt-2 text-white/60"><%= t("tournaments.no_available") %></p>
        <%= link_to t("common.back"), organization_path(@organization), class: "btn-secondary mt-4" %>
      </div>
    <% end %>

    <% if @available_tournaments.any? %>
      <div class="mt-8">
        <%= link_to t("common.back"), organization_path(@organization),
            class: "text-indigo-400 hover:text-indigo-300 transition-colors" %>
      </div>
    <% end %>
  </main>
</div>
