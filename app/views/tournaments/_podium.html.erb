<div class="mb-8 p-6 bg-gradient-to-br from-amber-500/10 to-yellow-500/5 rounded-2xl border border-amber-500/20">
  <div class="text-center mb-6">
    <span class="text-4xl">🏆</span>
    <h2 class="text-xl font-bold text-white mt-2"><%= t("tournaments.podium.title") %></h2>
    <p class="text-white/60 text-sm"><%= @tournament.name %></p>
  </div>

  <div class="flex justify-center items-end gap-4">
    <% if podium[1] %>
      <div class="text-center flex-1 max-w-32">
        <div class="bg-white/5 rounded-xl p-4 border border-white/10">
          <span class="text-3xl">🥈</span>
          <% user = podium[1] %>
          <div class="mt-2">
            <% if user.avatar.attached? %>
              <%= image_tag user.avatar, class: "w-12 h-12 rounded-full object-cover mx-auto" %>
            <% elsif user.avatar_emoji %>
              <div class="w-12 h-12 rounded-full bg-white/20 flex items-center justify-center mx-auto">
                <span class="text-2xl"><%= user.avatar_emoji %></span>
              </div>
            <% else %>
              <div class="w-12 h-12 rounded-full bg-white/20 flex items-center justify-center mx-auto">
                <span class="text-lg text-white/80"><%= user.display_name[0].upcase %></span>
              </div>
            <% end %>
            <p class="text-white font-medium mt-2 text-sm truncate"><%= user.display_name %></p>
            <p class="text-white/60 text-xs"><%= number_with_precision(user.total_points, precision: 2, strip_insignificant_zeros: true) %> pts</p>
          </div>
        </div>
      </div>
    <% end %>

    <% if podium[0] %>
      <div class="text-center flex-1 max-w-36">
        <div class="bg-gradient-to-br from-amber-500/20 to-yellow-500/10 rounded-xl p-5 border border-amber-500/30 transform scale-110">
          <span class="text-4xl">🥇</span>
          <% user = podium[0] %>
          <div class="mt-2">
            <% if user.avatar.attached? %>
              <%= image_tag user.avatar, class: "w-14 h-14 rounded-full object-cover mx-auto ring-2 ring-amber-500/50" %>
            <% elsif user.avatar_emoji %>
              <div class="w-14 h-14 rounded-full bg-amber-500/20 flex items-center justify-center mx-auto ring-2 ring-amber-500/50">
                <span class="text-2xl"><%= user.avatar_emoji %></span>
              </div>
            <% else %>
              <div class="w-14 h-14 rounded-full bg-amber-500/20 flex items-center justify-center mx-auto ring-2 ring-amber-500/50">
                <span class="text-xl text-white"><%= user.display_name[0].upcase %></span>
              </div>
            <% end %>
            <p class="text-white font-bold mt-2 truncate"><%= user.display_name %></p>
            <p class="text-amber-400 text-sm font-semibold"><%= number_with_precision(user.total_points, precision: 2, strip_insignificant_zeros: true) %> pts</p>
          </div>
        </div>
      </div>
    <% end %>

    <% if podium[2] %>
      <div class="text-center flex-1 max-w-32">
        <div class="bg-white/5 rounded-xl p-4 border border-white/10">
          <span class="text-3xl">🥉</span>
          <% user = podium[2] %>
          <div class="mt-2">
            <% if user.avatar.attached? %>
              <%= image_tag user.avatar, class: "w-12 h-12 rounded-full object-cover mx-auto" %>
            <% elsif user.avatar_emoji %>
              <div class="w-12 h-12 rounded-full bg-white/20 flex items-center justify-center mx-auto">
                <span class="text-2xl"><%= user.avatar_emoji %></span>
              </div>
            <% else %>
              <div class="w-12 h-12 rounded-full bg-white/20 flex items-center justify-center mx-auto">
                <span class="text-lg text-white/80"><%= user.display_name[0].upcase %></span>
              </div>
            <% end %>
            <p class="text-white font-medium mt-2 text-sm truncate"><%= user.display_name %></p>
            <p class="text-white/60 text-xs"><%= number_with_precision(user.total_points, precision: 2, strip_insignificant_zeros: true) %> pts</p>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="text-center mt-6">
    <%= link_to tournament_leaderboard_path(@tournament, organization_id: @organization.id), class: "text-sm text-amber-400 hover:text-amber-300 transition-colors" do %>
      <%= t("tournaments.podium.see_full_ranking") %> →
    <% end %>
  </div>
</div>
