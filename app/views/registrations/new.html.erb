<%= render layout: "shared/auth_layout", locals: { title: t("auth.register"), subtitle: capture { %>
  <%= t("auth.already_have_account") %>
  <%= link_to t("auth.login"), new_session_path, class: "font-medium text-indigo-300 hover:text-indigo-200" %>
<% } } do %>
  <% if @user.errors.any? %>
    <div class="mb-4 alert-error">
      <ul class="list-disc list-inside text-sm">
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @user, url: registration_path, class: "space-y-4" do |f| %>
    <div>
      <%= f.label :email_address, t("auth.email"), class: "auth-label" %>
      <%= f.email_field :email_address, required: true, autofocus: true, autocomplete: "email",
          placeholder: "tu@email.com", class: "auth-input" %>
    </div>

    <div>
      <%= f.label :password, t("auth.password"), class: "auth-label" %>
      <%= f.password_field :password, required: true, autocomplete: "new-password",
          placeholder: "********", class: "auth-input" %>
    </div>

    <div>
      <%= f.label :password_confirmation, t("auth.password_confirmation"), class: "auth-label" %>
      <%= f.password_field :password_confirmation, required: true, autocomplete: "new-password",
          placeholder: "********", class: "auth-input" %>
    </div>

    <%= f.submit t("auth.register_button"), class: "btn-primary btn-lg w-full shadow-lg" %>
  <% end %>
<% end %>
