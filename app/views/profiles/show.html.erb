<div>
  <%= render "shared/navbar" %>

  <main class="max-w-2xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
    <% if notice %>
      <div class="mb-4 alert-success"><%= notice %></div>
    <% end %>

    <h1 class="text-2xl font-bold text-white mb-6"><%= t("profile.title") %></h1>

    <div class="card p-6">
      <%= form_with model: @user, url: profile_path, method: :patch, class: "space-y-6" do |f| %>
        <% if @user.errors.any? %>
          <div class="alert-error">
            <ul class="list-disc list-inside">
              <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= f.label :name, t("profile.name"), class: "block text-sm font-medium text-white/90" %>
          <%= f.text_field :name, placeholder: t("profile.name_placeholder"), class: "input mt-1" %>
          <p class="mt-1 text-sm text-white/50"><%= t("profile.name_hint") %></p>
        </div>

        <div>
          <label class="block text-sm font-medium text-white/90 mb-3"><%= t("profile.avatar") %></label>

          <div class="flex items-start gap-6">
            <div class="shrink-0">
              <% if @user.avatar.attached? %>
                <%= image_tag @user.avatar, class: "w-24 h-24 rounded-full object-cover border-2 border-white/20" %>
              <% elsif @user.avatar_emoji %>
                <div class="w-24 h-24 rounded-full bg-white/10 border-2 border-indigo-500 flex items-center justify-center">
                  <span class="text-5xl"><%= @user.avatar_emoji %></span>
                </div>
              <% else %>
                <div class="w-24 h-24 rounded-full bg-white/10 border-2 border-white/20 flex items-center justify-center">
                  <span class="text-3xl text-white/40"><%= @user.display_name[0].upcase %></span>
                </div>
              <% end %>
            </div>

            <div class="flex-1 space-y-4">
              <div>
                <p class="text-sm text-white/70 mb-2"><%= t("profile.upload_photo") %></p>
                <%= f.file_field :avatar, accept: "image/*", class: "block w-full text-sm text-white/60 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-indigo-600 file:text-white hover:file:bg-indigo-500 file:cursor-pointer" %>
              </div>

              <% if @user.avatar.attached? || @user.avatar_preset.present? %>
                <div>
                  <%= link_to t("profile.remove_avatar"), profile_path(remove_avatar: 1), data: { turbo_method: :patch }, class: "text-sm text-red-400 hover:text-red-300" %>
                </div>
              <% end %>
            </div>
          </div>
        </div>

        <div>
          <p class="text-sm text-white/70 mb-3"><%= t("profile.or_choose_preset") %></p>
          <div class="grid grid-cols-6 sm:grid-cols-12 gap-2">
            <% User::AVATAR_PRESETS.each do |key, emoji| %>
              <label class="cursor-pointer">
                <%= f.radio_button :avatar_preset, key, class: "hidden peer" %>
                <div class="w-10 h-10 rounded-full bg-white/10 border-2 border-transparent peer-checked:border-indigo-500 peer-checked:bg-indigo-500/20 transition-all hover:border-white/40 flex items-center justify-center">
                  <span class="text-xl"><%= emoji %></span>
                </div>
              </label>
            <% end %>
          </div>
        </div>

        <div class="flex justify-end pt-4 border-t border-white/10">
          <%= f.submit t("profile.save"), class: "btn-primary" %>
        </div>
      <% end %>
    </div>

    <div class="mt-6 card p-6">
      <h2 class="text-lg font-medium text-white mb-4"><%= t("profile.account") %></h2>
      <div class="text-white/60">
        <p><strong class="text-white/80"><%= t("profile.email") %>:</strong> <%= @user.email_address %></p>
      </div>
    </div>
  </main>
</div>
