<div class="min-h-screen flex items-center justify-center relative">
  <%# Background image with blur %>
  <div class="absolute inset-0 z-0">
    <%= image_tag "bg-stadium.jpg", class: "w-full h-full object-cover blur-sm scale-105" %>
    <div class="absolute inset-0 bg-black/40"></div>
  </div>

  <%# Content %>
  <div class="relative z-10 flex flex-col items-center px-6 py-12">
    <%= image_tag "futpred-logo.svg", alt: t("app_name"), class: "h-40 drop-shadow-lg mb-8" %>

    <div class="max-w-md w-full text-center">
      <h2 class="text-3xl font-bold text-white drop-shadow-lg mb-4"><%= t("invites.title") %></h2>
      <p class="text-lg text-white/80 mb-8">
        <%= t("invites.invited_to", organization: @organization.name) %>
      </p>

      <%= button_to t("invites.join"), accept_invite_path(@organization.invite_token),
          method: :post,
          class: "w-full py-3 px-4 rounded-lg text-white font-semibold bg-indigo-600 hover:bg-indigo-500 cursor-pointer transition-colors shadow-lg" %>
    </div>
  </div>
</div>
