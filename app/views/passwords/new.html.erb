<div class="min-h-screen flex items-center justify-center bg-gray-50">
  <div class="max-w-md w-full space-y-8 p-8 bg-white rounded-lg shadow">
    <div>
      <h2 class="text-center text-3xl font-bold text-gray-900"><%= t("passwords.forgot_title") %></h2>
      <p class="mt-2 text-center text-sm text-gray-600">
        <%= t("passwords.forgot_description") %>
      </p>
    </div>

    <% if flash[:alert] %>
      <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <% if flash[:notice] %>
      <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded">
        <%= flash[:notice] %>
      </div>
    <% end %>

    <%= form_with url: passwords_path, class: "mt-8 space-y-6" do |f| %>
      <div>
        <%= f.label :email_address, t("auth.email"), class: "block text-sm font-medium text-gray-700" %>
        <%= f.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address],
            class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>

      <%= f.submit t("passwords.send_instructions"), class: "w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 cursor-pointer" %>
    <% end %>

    <div class="text-center">
      <%= link_to t("passwords.back_to_login"), new_session_path, class: "text-sm text-indigo-600 hover:text-indigo-500" %>
    </div>
  </div>
</div>
