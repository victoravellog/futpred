<%= render layout: "shared/auth_layout", locals: { title: t("passwords.forgot_title"), subtitle: t("passwords.forgot_description") } do %>
  <%= form_with url: passwords_path, class: "space-y-4" do |f| %>
    <div>
      <%= f.label :email_address, t("auth.email"), class: "auth-label" %>
      <%= f.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
          value: params[:email_address], placeholder: "tu@email.com", class: "auth-input" %>
    </div>

    <%= f.submit t("passwords.send_instructions"), class: "btn-primary btn-lg w-full shadow-lg" %>
  <% end %>

  <div class="mt-4 text-center lg:text-left">
    <%= link_to t("passwords.back_to_login"), new_session_path, class: "text-sm text-white/70 hover:text-white transition-colors" %>
  </div>
<% end %>
