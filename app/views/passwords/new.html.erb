<div class="min-h-screen flex items-center justify-center relative">
  <%# Background image with blur %>
  <div class="absolute inset-0 z-0">
    <%= image_tag "bg-stadium.jpg", class: "w-full h-full object-cover blur-sm scale-105" %>
    <div class="absolute inset-0 bg-black/40"></div>
  </div>

  <%# Content - 2 columns %>
  <div class="relative z-10 flex flex-col lg:flex-row items-center gap-12 lg:gap-24 px-6 py-12 max-w-5xl mx-auto">
    <%# Left - Logo %>
    <div class="flex-1 flex items-center justify-center">
      <%= image_tag "futpred-logo.svg", alt: t("app_name"), class: "h-56 lg:h-96 drop-shadow-lg" %>
    </div>

    <%# Right - Form %>
    <div class="w-full max-w-sm">
      <div class="text-center lg:text-left mb-6">
        <h2 class="text-3xl font-bold text-white drop-shadow-lg"><%= t("passwords.forgot_title") %></h2>
        <p class="mt-2 text-sm text-white/80">
          <%= t("passwords.forgot_description") %>
        </p>
      </div>

      <% if flash[:alert] %>
        <div class="mb-4 bg-red-500/80 backdrop-blur-sm text-white px-4 py-3 rounded-lg">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <% if flash[:notice] %>
        <div class="mb-4 bg-green-500/80 backdrop-blur-sm text-white px-4 py-3 rounded-lg">
          <%= flash[:notice] %>
        </div>
      <% end %>

      <%= form_with url: passwords_path, class: "space-y-4" do |f| %>
        <div>
          <%= f.label :email_address, t("auth.email"), class: "block text-sm font-medium text-white/90 mb-1" %>
          <%= f.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address],
              placeholder: "tu@email.com",
              class: "block w-full px-4 py-3 bg-white/20 backdrop-blur-sm border border-white/30 rounded-lg text-white placeholder-white/50 focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent" %>
        </div>

        <%= f.submit t("passwords.send_instructions"), class: "w-full py-3 px-4 rounded-lg text-white font-semibold bg-indigo-600 hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 cursor-pointer transition-colors shadow-lg" %>
      <% end %>

      <div class="mt-4 text-center lg:text-left">
        <%= link_to t("passwords.back_to_login"), new_session_path, class: "text-sm text-white/70 hover:text-white transition-colors" %>
      </div>
    </div>
  </div>
</div>
