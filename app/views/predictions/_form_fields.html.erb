<% if fixture.predictable? %>
  <%= form_with model: prediction, url: fixture_prediction_path(fixture),
      method: prediction.persisted? ? :patch : :post,
      class: "flex items-center gap-1.5" do |f| %>
    <%= f.number_field :predicted_home_score, min: 0, max: 20, value: prediction.predicted_home_score,
        class: "w-10 text-center px-1 py-1 bg-white/10 border border-white/20 rounded text-sm text-white placeholder-white/40 focus:ring-2 focus:ring-indigo-400 focus:border-transparent",
        placeholder: "0" %>
    <span class="text-white/40 text-sm">-</span>
    <%= f.number_field :predicted_away_score, min: 0, max: 20, value: prediction.predicted_away_score,
        class: "w-10 text-center px-1 py-1 bg-white/10 border border-white/20 rounded text-sm text-white placeholder-white/40 focus:ring-2 focus:ring-indigo-400 focus:border-transparent",
        placeholder: "0" %>
    <%= f.submit "✓",
        class: "ml-1 px-2.5 py-1 text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-500 rounded cursor-pointer transition-all duration-150" %>
  <% end %>
  <% if prediction.errors.any? %>
    <p class="mt-1 text-xs text-red-400"><%= prediction.errors.full_messages.first %></p>
  <% end %>
<% end %>
