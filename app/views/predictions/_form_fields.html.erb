<% if fixture.predictable? %>
  <% show_multi_group_dialog = prediction.persisted? && local_assigns[:user_in_multiple_groups] %>
  <div class="flex items-center gap-1.5"
       <% if show_multi_group_dialog %>
       data-controller="prediction-scope"
       data-prediction-scope-fixture-id-value="<%= fixture.id %>"
       data-prediction-scope-organization-tournament-id-value="<%= organization_tournament&.id %>"
       <% end %>>
    <% if !prediction.persisted? %>
      <span class="w-1.5 h-1.5 bg-amber-400 rounded-full animate-pulse" title="<%= t('predictions.pending') %>"></span>
    <% end %>
    <%= form_with model: prediction, url: fixture_prediction_path(fixture),
        method: prediction.persisted? ? :patch : :post,
        class: "flex items-center gap-1.5",
        data: show_multi_group_dialog ? { prediction_scope_target: "form", action: "submit->prediction-scope#intercept" } : {} do |f| %>
      <%= hidden_field_tag :organization_tournament_id, organization_tournament&.id %>
      <%= f.number_field :predicted_home_score, min: 0, max: 20, value: prediction.predicted_home_score || 0,
          class: "w-10 text-center px-1 py-1 bg-white/10 border #{prediction.persisted? ? 'border-green-500/30' : 'border-amber-400/30'} rounded text-sm text-white placeholder-white/40 focus:ring-2 focus:ring-indigo-400 focus:border-transparent" %>
      <span class="text-white/40 text-sm">-</span>
      <%= f.number_field :predicted_away_score, min: 0, max: 20, value: prediction.predicted_away_score || 0,
          class: "w-10 text-center px-1 py-1 bg-white/10 border #{prediction.persisted? ? 'border-green-500/30' : 'border-amber-400/30'} rounded text-sm text-white placeholder-white/40 focus:ring-2 focus:ring-indigo-400 focus:border-transparent" %>
      <% if prediction.persisted? %>
        <%= f.submit "✓",
            class: "ml-1 px-2.5 py-1 text-sm font-medium text-white bg-green-600 hover:bg-green-500 rounded cursor-pointer transition-all duration-150",
            title: t('predictions.saved') %>
      <% else %>
        <%= f.submit t("predictions.save"),
            class: "ml-1 px-2.5 py-1 text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-500 rounded cursor-pointer transition-all duration-150" %>
      <% end %>
    <% end %>

    <% if show_multi_group_dialog %>
      <template data-prediction-scope-target="dialog">
        <div class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
          <div class="bg-slate-800 rounded-xl border border-white/10 p-5 max-w-sm w-full shadow-xl">
            <h3 class="text-lg font-semibold text-white mb-3"><%= t("predictions.scope_dialog.title") %></h3>
            <p class="text-sm text-white/70 mb-4"><%= t("predictions.scope_dialog.description") %></p>
            <div class="flex flex-col gap-2">
              <button type="button" data-scope-action="this"
                      class="w-full px-4 py-2 text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-500 rounded-lg transition-colors">
                <%= t("predictions.scope_dialog.this_group_only") %>
              </button>
              <button type="button" data-scope-action="all"
                      class="w-full px-4 py-2 text-sm font-medium text-white bg-white/10 hover:bg-white/20 rounded-lg transition-colors">
                <%= t("predictions.scope_dialog.all_groups") %>
              </button>
              <button type="button" data-scope-action="cancel"
                      class="w-full px-4 py-2 text-sm text-white/50 hover:text-white/80 transition-colors">
                <%= t("predictions.scope_dialog.cancel") %>
              </button>
            </div>
          </div>
        </div>
      </template>
    <% end %>
  </div>
  <% if prediction.errors.any? %>
    <p class="mt-1 text-xs text-red-400"><%= prediction.errors.full_messages.first %></p>
  <% end %>
<% end %>
