<%= turbo_frame_tag dom_id(fixture, :prediction_form) do %>
  <div class="rounded-lg transition-all duration-300">
    <% if fixture.finished? %>
      <% if prediction.persisted? %>
        <div class="flex items-center gap-2">
          <span class="text-sm font-medium <%= prediction.exact_score? ? 'text-green-400' : (prediction.correct_result? ? 'text-blue-400' : 'text-white/50') %>">
            <%= prediction.predicted_home_score %> - <%= prediction.predicted_away_score %>
          </span>
          <% if prediction.points_earned.present? && prediction.points_earned > 0 %>
            <span class="text-xs font-semibold px-1.5 py-0.5 rounded-full <%= prediction.exact_score? ? 'bg-green-500/20 text-green-400' : 'bg-blue-500/20 text-blue-400' %>">
              +<%= number_with_precision(prediction.points_earned, precision: 2, strip_insignificant_zeros: true) %>
            </span>
          <% end %>
        </div>
      <% else %>
        <span class="text-xs text-white/40"><%= t("fixtures.no_prediction") %></span>
      <% end %>
    <% elsif fixture.predictable? %>
      <%= render "predictions/form_fields", fixture: fixture, prediction: prediction, organization_tournament: organization_tournament, user_in_multiple_groups: user_in_multiple_groups %>
    <% else %>
      <% if prediction.persisted? %>
        <div class="flex items-center gap-2">
          <span class="text-sm font-medium text-white/70">
            <%= prediction.predicted_home_score %> - <%= prediction.predicted_away_score %>
          </span>
          <span class="text-[10px] text-white/40"><%= t("fixtures.closed") %></span>
        </div>
      <% else %>
        <span class="text-xs text-white/40"><%= t("fixtures.closed") %></span>
      <% end %>
    <% end %>
  </div>
<% end %>
