<div>
  <%= render "shared/navbar" %>

  <main class="max-w-4xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
    <div class="mb-6">
      <div class="flex items-center space-x-4">
        <%= link_to tournament_path(@tournament, organization_id: @organization.id), class: "text-white/50 hover:text-white transition-colors" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
        <% end %>
        <div>
          <h1 class="text-2xl font-bold text-white"><%= t("leaderboard.title") %></h1>
          <p class="text-white/60"><%= @tournament.name %> · <%= @organization.name %></p>
        </div>
      </div>
    </div>

    <div class="card overflow-hidden">
      <% if @rankings.any? %>
        <table class="min-w-full divide-y divide-white/10">
          <thead class="bg-white/5">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-white/50 uppercase tracking-wider w-16"><%= t("leaderboard.position") %></th>
              <th class="px-6 py-3 text-left text-xs font-medium text-white/50 uppercase tracking-wider"><%= t("leaderboard.user") %></th>
              <th class="px-6 py-3 text-right text-xs font-medium text-white/50 uppercase tracking-wider"><%= t("leaderboard.points") %></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5">
            <% @rankings.each_with_index do |user, index| %>
              <tr class="<%= user.id == Current.user.id ? 'bg-indigo-500/20' : '' %>">
                <td class="px-6 py-4 whitespace-nowrap">
                  <% if index == 0 %>
                    <span class="text-2xl">🥇</span>
                  <% elsif index == 1 %>
                    <span class="text-2xl">🥈</span>
                  <% elsif index == 2 %>
                    <span class="text-2xl">🥉</span>
                  <% else %>
                    <span class="text-white/60 font-medium"><%= index + 1 %></span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="flex items-center space-x-3">
                    <% if user.avatar.attached? %>
                      <%= image_tag user.avatar, class: "w-8 h-8 rounded-full object-cover" %>
                    <% elsif user.avatar_emoji %>
                      <div class="w-8 h-8 rounded-full bg-white/20 flex items-center justify-center">
                        <span class="text-lg"><%= user.avatar_emoji %></span>
                      </div>
                    <% else %>
                      <div class="w-8 h-8 rounded-full bg-white/20 flex items-center justify-center">
                        <span class="text-sm text-white/80"><%= user.display_name[0].upcase %></span>
                      </div>
                    <% end %>
                    <div>
                      <span class="<%= user.id == Current.user.id ? 'font-bold text-indigo-400' : 'text-white' %>">
                        <%= user.display_name %>
                      </span>
                      <% if user.id == Current.user.id %>
                        <span class="ml-2 text-xs text-indigo-400"><%= t("leaderboard.you") %></span>
                      <% end %>
                    </div>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right">
                  <span class="text-lg font-bold text-white"><%= number_with_precision(user.total_points, precision: 2, strip_insignificant_zeros: true) %></span>
                  <span class="text-white/50 text-sm">pts</span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <div class="text-center py-12">
          <p class="text-white/50"><%= t("leaderboard.no_scores") %></p>
          <p class="text-sm text-white/30 mt-2"><%= t("leaderboard.no_scores_hint") %></p>
        </div>
      <% end %>
    </div>
  </main>
</div>
