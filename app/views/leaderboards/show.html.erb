<div class="min-h-screen bg-gray-50">
  <%= render "shared/navbar" %>

  <main class="max-w-4xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
    <div class="mb-6">
      <div class="flex items-center space-x-4">
        <%= link_to tournament_path(@tournament), class: "text-gray-500 hover:text-gray-700" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
        <% end %>
        <div>
          <h1 class="text-2xl font-bold text-gray-900"><%= t("leaderboard.title") %></h1>
          <p class="text-gray-500"><%= @tournament.name %></p>
        </div>
      </div>
    </div>

    <div class="bg-white shadow rounded-lg overflow-hidden">
      <% if @rankings.any? %>
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-16"><%= t("leaderboard.position") %></th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t("leaderboard.user") %></th>
              <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t("leaderboard.points") %></th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @rankings.each_with_index do |user, index| %>
              <tr class="<%= user.id == Current.user.id ? 'bg-indigo-50' : '' %>">
                <td class="px-6 py-4 whitespace-nowrap">
                  <% if index == 0 %>
                    <span class="text-2xl">🥇</span>
                  <% elsif index == 1 %>
                    <span class="text-2xl">🥈</span>
                  <% elsif index == 2 %>
                    <span class="text-2xl">🥉</span>
                  <% else %>
                    <span class="text-gray-500 font-medium"><%= index + 1 %></span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="<%= user.id == Current.user.id ? 'font-bold text-indigo-600' : 'text-gray-900' %>">
                    <%= user.email_address.split('@').first %>
                  </span>
                  <% if user.id == Current.user.id %>
                    <span class="ml-2 text-xs text-indigo-500"><%= t("leaderboard.you") %></span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right">
                  <span class="text-lg font-bold text-gray-900"><%= user.total_points.to_i %></span>
                  <span class="text-gray-500 text-sm">pts</span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <div class="text-center py-12">
          <p class="text-gray-500"><%= t("leaderboard.no_scores") %></p>
          <p class="text-sm text-gray-400 mt-2"><%= t("leaderboard.no_scores_hint") %></p>
        </div>
      <% end %>
    </div>
  </main>
</div>
