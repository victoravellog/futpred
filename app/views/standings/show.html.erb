<div>
  <%= render "shared/navbar" %>

  <main class="max-w-4xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
    <div class="mb-6">
      <div class="flex items-center space-x-4">
        <%= link_to tournament_path(@tournament, organization_id: @organization.id), class: "text-white/50 hover:text-white transition-colors" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
        <% end %>
        <div>
          <h1 class="text-2xl font-bold text-white"><%= t("standings.title") %></h1>
          <p class="text-white/60"><%= @tournament.name %></p>
        </div>
      </div>
    </div>

    <div class="card overflow-hidden">
      <% if @standings.any? %>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-white/10">
            <thead class="bg-white/5">
              <tr>
                <th class="px-3 py-3 text-left text-xs font-medium text-white/50 uppercase tracking-wider w-12">#</th>
                <th class="px-3 py-3 text-left text-xs font-medium text-white/50 uppercase tracking-wider"><%= t("standings.team") %></th>
                <th class="px-3 py-3 text-center text-xs font-medium text-white/50 uppercase tracking-wider w-12"><%= t("standings.played_short") %></th>
                <th class="px-3 py-3 text-center text-xs font-medium text-white/50 uppercase tracking-wider w-12"><%= t("standings.won_short") %></th>
                <th class="px-3 py-3 text-center text-xs font-medium text-white/50 uppercase tracking-wider w-12"><%= t("standings.draw_short") %></th>
                <th class="px-3 py-3 text-center text-xs font-medium text-white/50 uppercase tracking-wider w-12"><%= t("standings.lost_short") %></th>
                <th class="px-3 py-3 text-center text-xs font-medium text-white/50 uppercase tracking-wider w-12"><%= t("standings.gf_short") %></th>
                <th class="px-3 py-3 text-center text-xs font-medium text-white/50 uppercase tracking-wider w-12"><%= t("standings.ga_short") %></th>
                <th class="px-3 py-3 text-center text-xs font-medium text-white/50 uppercase tracking-wider w-12"><%= t("standings.gd_short") %></th>
                <th class="px-3 py-3 text-center text-xs font-medium text-white/50 uppercase tracking-wider w-14"><%= t("standings.points_short") %></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/5">
              <% @standings.each do |standing| %>
                <tr class="hover:bg-white/5 transition-colors">
                  <td class="px-3 py-3 whitespace-nowrap">
                    <span class="text-white/60 font-medium"><%= standing.position %></span>
                  </td>
                  <td class="px-3 py-3 whitespace-nowrap">
                    <div class="flex items-center gap-3">
                      <img src="<%= standing.team.logo_url %>" alt="<%= standing.team.name %>" class="w-6 h-6 object-contain" onerror="this.style.display='none'">
                      <span class="text-white font-medium text-sm"><%= standing.team.display_name %></span>
                    </div>
                  </td>
                  <td class="px-3 py-3 whitespace-nowrap text-center text-white/70 text-sm"><%= standing.played_games %></td>
                  <td class="px-3 py-3 whitespace-nowrap text-center text-white/70 text-sm"><%= standing.won %></td>
                  <td class="px-3 py-3 whitespace-nowrap text-center text-white/70 text-sm"><%= standing.draw %></td>
                  <td class="px-3 py-3 whitespace-nowrap text-center text-white/70 text-sm"><%= standing.lost %></td>
                  <td class="px-3 py-3 whitespace-nowrap text-center text-white/70 text-sm"><%= standing.goals_for %></td>
                  <td class="px-3 py-3 whitespace-nowrap text-center text-white/70 text-sm"><%= standing.goals_against %></td>
                  <td class="px-3 py-3 whitespace-nowrap text-center text-sm <%= standing.goal_difference >= 0 ? 'text-green-400' : 'text-red-400' %>">
                    <%= standing.goal_difference >= 0 ? "+#{standing.goal_difference}" : standing.goal_difference %>
                  </td>
                  <td class="px-3 py-3 whitespace-nowrap text-center">
                    <span class="text-white font-bold"><%= standing.points %></span>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center py-12">
          <p class="text-white/50"><%= t("standings.no_data") %></p>
          <p class="text-sm text-white/30 mt-2"><%= t("standings.no_data_hint") %></p>
        </div>
      <% end %>
    </div>
  </main>
</div>
