# Kamal secrets - loaded at deploy time
# DO NOT commit real values here - use environment variables or password manager

# GitHub Container Registry token (create at https://github.com/settings/tokens)
# Needs: write:packages, read:packages, delete:packages
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Rails master key
RAILS_MASTER_KEY=$RAILS_MASTER_KEY

# PostgreSQL password for production
FUTPRED_DATABASE_PASSWORD=$FUTPRED_DATABASE_PASSWORD
POSTGRES_PASSWORD=$FUTPRED_DATABASE_PASSWORD
